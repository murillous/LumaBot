{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Base de todos os pacotes de packages/*, plugins/* e apps/*. Cada pacote estende este
  // arquivo e define só rootDir/outDir/include/references (caminhos aqui seriam relativos à raiz).
  "compilerOptions": {
    // Node 24 roda ES2024 nativo — nada de downlevel.
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],

    // ESM puro com a resolução do Node.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,

    // Em dev o Node executa o .ts direto (type stripping, D26): só sintaxe apagável
    // (sem enum/namespace/parameter properties) e imports com extensão `.ts`.
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,

    // Aliases @zapforge/*: cada pacote exporta o fonte sob esta condição (ver README).
    "customConditions": ["@zapforge/source"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    // O tsc só checa tipos (`tsc -b`); o JS e os .d.ts publicados saem do tsdown. Project
    // references exigem composite + emissão de declarações, que vão para .tsbuild/ (ignorado).
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    // Tipos explícitos na API exportada: o tsdown gera os .d.ts via oxc, sem depender da API
    // ainda experimental do TypeScript 7.
    "isolatedDeclarations": true,

    "skipLibCheck": true
  }
}
