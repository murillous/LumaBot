{
  "name": "lumabot",
  "version": "0.0.0",
  "private": true,
  "description": "LumaBot sobre o Bridger: compõe transport, storage e plugins.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "tsdown && pnpm --filter @lumabot/dashboard build",
    "start": "node --env-file-if-exists=.env dist/main.mjs",
    "dev": "node --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc && pnpm --filter @lumabot/dashboard typecheck",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/deepseek": "^3.0.66",
    "@ai-sdk/google": "^4.0.98",
    "@ai-sdk/openai": "^4.0.95",
    "@usebridger/core": "^0.10.0",
    "@usebridger/plugin-dashboard": "^0.4.0",
    "@usebridger/plugin-metrics": "^0.3.0",
    "@usebridger/storage-sqlite": "^0.3.3",
    "@usebridger/transport-baileys": "^0.6.0",
    "ai": "^7.0.142",
    "node-webpmux": "^3.2.1",
    "pdf-lib": "^1.17.1",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@usebridger/testing": "^0.7.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
