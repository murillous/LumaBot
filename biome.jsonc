{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    // Gerados: openapi.json e api-types.d.ts saem do `pnpm gen:api` do dashboard.
    "includes": [
      "**",
      "!**/dist",
      "!pnpm-lock.yaml",
      "!dashboard/openapi.json",
      "!dashboard/src/lib/api-types.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  // O Tailwind v4 usa @theme, @apply e afins no CSS do dashboard.
  "css": { "parser": { "tailwindDirectives": true } },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // Convenções do repositório (CLAUDE.md): só named exports...
        "noDefaultExport": "error",
        // ...nenhum process.env fora da camada de config (ver overrides)...
        "noProcessEnv": "error",
        // ...e imports nunca subindo diretórios.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../**", ".."],
                "message": "Import relativo ascendente: use o alias # do pacote ou reorganize o módulo."
              }
            ]
          }
        }
      },
      "complexity": {
        // Conflita com noPropertyAccessFromIndexSignature do tsconfig, que exige env['X'].
        "useLiteralKeys": "off"
      },
      "suspicious": {
        // Nunca engolir erros: bloco vazio (incluindo catch {}) é erro.
        "noEmptyBlockStatements": "error"
      }
    }
  },
  "plugins": ["./biome/no-swallowed-catch.grit"],
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      // Arquivos de config de ferramentas (vitest, tsdown...) exigem export default.
      "includes": ["**/*.config.ts", "**/*.config.mts", "**/*.config.js"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      // A camada de config é o único lugar que lê process.env.
      "includes": ["**/src/config.ts", "**/src/config/**"],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    },
    {
      // Plugins genéricos de IA (#484): o `ai` não importa nada do app.
      "includes": ["src/plugins/ai/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", ".."],
                    "message": "Import relativo ascendente: use o alias # do pacote ou reorganize o módulo."
                  },
                  {
                    "group": ["#*", "#*/**", "!#plugins/ai/**"],
                    "message": "Plugin genérico de IA (vai para o usebridger): importe só o próprio `ai`, nunca o app."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // O `ai-context` depende só do `ai`.
      "includes": ["src/plugins/ai-context/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", ".."],
                    "message": "Import relativo ascendente: use o alias # do pacote ou reorganize o módulo."
                  },
                  {
                    "group": ["#*", "#*/**", "!#plugins/ai/**", "!#plugins/ai-context/**"],
                    "message": "Plugin genérico de IA (vai para o usebridger): importe só o `ai` e o próprio `ai-context`, nunca o app."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Cada provider depende só do `ai` e da própria pasta.
      "includes": [
        "src/plugins/ai-google/**",
        "src/plugins/ai-openai/**",
        "src/plugins/ai-anthropic/**",
        "src/plugins/ai-deepseek/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", ".."],
                    "message": "Import relativo ascendente: use o alias # do pacote ou reorganize o módulo."
                  },
                  {
                    "group": ["#*", "#*/**", "!#plugins/ai/**"],
                    "message": "Plugin genérico de IA (vai para o usebridger): importe só o `ai`, nunca o app."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
