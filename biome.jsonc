{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/dist", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // Convenções do repositório (CLAUDE.md): só named exports...
        "noDefaultExport": "error",
        // ...nenhum process.env fora da camada de config (ver overrides)...
        "noProcessEnv": "error",
        // ...e imports nunca subindo diretórios.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../**", ".."],
                "message": "Import relativo ascendente: use o alias # do pacote ou reorganize o módulo."
              }
            ]
          }
        }
      },
      "complexity": {
        // Conflita com noPropertyAccessFromIndexSignature do tsconfig, que exige env['X'].
        "useLiteralKeys": "off"
      },
      "suspicious": {
        // Nunca engolir erros: bloco vazio (incluindo catch {}) é erro.
        "noEmptyBlockStatements": "error"
      }
    }
  },
  "plugins": ["./biome/no-swallowed-catch.grit"],
  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },
  "overrides": [
    {
      // Arquivos de config de ferramentas (vitest, tsdown...) exigem export default.
      "includes": ["**/*.config.ts", "**/*.config.mts", "**/*.config.js"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      // A camada de config é o único lugar que lê process.env.
      "includes": ["**/src/config.ts", "**/src/config/**"],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    }
  ]
}
