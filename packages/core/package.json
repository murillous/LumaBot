{
  "name": "@zapforge/core",
  "version": "0.0.0",
  "description": "Kernel do ZapForge: bot de mensageria extensível por plugins.",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "@zapforge/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./adapter": {
      "@zapforge/source": "./src/adapter.ts",
      "types": "./dist/adapter.d.mts",
      "default": "./dist/adapter.mjs"
    },
    "./storage-contract": {
      "@zapforge/source": "./src/storage/contract/index.ts",
      "types": "./dist/storage-contract.d.mts",
      "default": "./dist/storage-contract.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
