{
  "name": "@usebridger/core",
  "version": "0.0.0",
  "description": "Kernel do Bridger: bot de mensageria extensível por plugins.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murillous/usebridger.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/murillous/usebridger/tree/develop/packages/core/docs#readme",
  "bugs": "https://github.com/murillous/usebridger/issues",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "@usebridger/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./adapter": {
      "@usebridger/source": "./src/adapter.ts",
      "types": "./dist/adapter.d.mts",
      "default": "./dist/adapter.mjs"
    },
    "./storage-contract": {
      "@usebridger/source": "./src/storage/contract/index.ts",
      "types": "./dist/storage-contract.d.mts",
      "default": "./dist/storage-contract.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
