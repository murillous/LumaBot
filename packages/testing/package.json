{
  "name": "@usebridger/testing",
  "version": "0.0.0",
  "description": "Kit de testes do Bridger: bot com transport falso e matchers para o Vitest.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/murillous/usebridger.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/murillous/usebridger/tree/develop/packages/testing/docs#readme",
  "bugs": "https://github.com/murillous/usebridger/issues",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "@usebridger/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./bot": {
      "@usebridger/source": "./src/bot.ts",
      "types": "./dist/bot.d.mts",
      "default": "./dist/bot.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@usebridger/core": "workspace:^"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
