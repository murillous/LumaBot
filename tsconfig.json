{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Node 24 roda ES2024 nativo — nada de downlevel.
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],

    // ESM puro com a resolução do Node.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,

    // Em dev o Node executa o .ts direto (type stripping): só sintaxe apagável
    // (sem enum/namespace/parameter properties) e imports com extensão `.ts`.
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,

    // O tsc só checa tipos; o JS sai do tsdown.
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "*.config.ts"]
}
